{
  "name": "card-drop",
  "version": "0.10.1",
  "main": "./dist/bot.js",
  "typings": "./dist",
  "scripts": {
    "clean": "rm -rf node_modules/ dist/",
    "build": "tsc",
    "start": "node ./dist/bot.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:up": "typeorm migration:run -d dist/database/dataSources/appDataSource.js",
    "db:down": "typeorm migration:revert -d dist/database/dataSources/appDataSource.js",
    "db:create": "typeorm migration:create ./src/database/migrations/app/new",
    "release": "np --no-publish"
  },
  "repository": "https://git.vylpes.xyz/External/card-drop.git",
  "author": "Ethan Lane <ethan@vylpes.com>",
  "license": "MIT",
  "bugs": {
    "url": "https//git.vylpes.xyz/External/card-drop/issues",
    "email": "helpdesk@vylpes.com"
  },
  "homepage": "https://gitea.vylpes.xyz/External/card-drop",
  "funding": "https://ko-fi.com/vylpes",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "canvas": "^3.2.3",
    "clone-deep": "^4.0.1",
    "cron": "^4.3.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "jimp": "^1.6.1",
    "minimatch": "^10.2.6",
    "mysql": "^2.18.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.31",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-discord-transport": "^1.3.0"
  },
  "resolutions": {
    "winston-discord-transport/logform": "^2.7.0",
    "**/tmp": "^0.2.7",
    "**/body-parser": "^2.3.0",
    "**/form-data": "^4.0.6",
    "**/path-to-regexp": "^8.4.2",
    "**/qs": "^6.16.0",
    "**/uuid": "^11.1.1",
    "**/moment": "^2.31.0",
    "braces": "file:./vendor/braces"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/clone-deep": "^4.0.4",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "np": "^10.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  }
}
